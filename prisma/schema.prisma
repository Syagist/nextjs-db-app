generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id        String   @id @default(uuid())
    email     String   @unique
    password  String
    avatarUrl String?
    name      String?
    createdAt DateTime @default(now())

    posts Post[] 
}

model Post {
    id        Int      @id @default(autoincrement())
    title     String
    content   String
    createdAt DateTime @default(now())

    userId String
    user   User   @relation(fields: [userId], references: [id])
}
